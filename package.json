{
  "name": "e2e-playwright",
  "version": "0.2.1",
  "description": "End-to-end Playwright suite for api and web applications",
  "keywords": [
    "archetype",
    "e2e",
    "playwright",
    "starter",
    "test"
  ],
  "homepage": "https://aiddbot.com",
  "license": "MIT",
  "author": {
    "name": "Alberto Basalo",
    "email": "albertobasalo@aicode.academy",
    "url": "https://aicode.academy"
  },
  "repository": "https://github.com/AIDDbot/e2e-playwright",
  "type": "module",
  "scripts": {
    "postinstall": "playwright install chromium",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report ./reports/html",
    "lint": "oxlint --format=agent --quiet",
    "lint:fix": "oxlint --fix --format=agent --quiet",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "fix": "node --run lint:fix && node --run format",
    "quality:warnings": "oxlint --deny-warnings --format=agent",
    "quality:complexity": "oxlint -c .oxlintrc.complexity.json --format=agent --quiet",
    "quality:all": "node --run quality:warnings && node --run quality:complexity"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "eslint-plugin-playwright": "^2.12.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003"
  },
  "config": {
    "codename": "oktoberfest"
  },
  "engines": {
    "node": ">=26.10.0"
  },
  "packageManager": "npm@12.0.0"
}