{
  "name": "e2e-playwright",
  "version": "0.2.0",
  "config": {
    "codename": "oktoberfest"
  },
  "description": "End-to-end Playwright suite for api and web applications",
  "homepage": "https://aiddbot.com",
  "license": "MIT",
  "author": {
    "name": "Alberto Basalo",
    "url": "https://x.com/albertobasalo"
  },
  "repository": "https://github.com/AIDDbot/e2e-playwright",
  "type": "module",
  "scripts": {
    "postinstall": "playwright install chromium",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report ./reports/html",
    "lint": "oxlint --format=agent --quiet",
    "lint:fix": "oxlint --fix --format=agent --quiet",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "fix": "bun run lint:fix && bun run format",
    "quality:warnings": "oxlint --deny-warnings --format=agent",
    "quality:complexity": "oxlint -c .oxlintrc.complexity.json --format=agent --quiet",
    "quality:all": "bun run quality:warnings && bun run quality:complexity"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "eslint-plugin-playwright": "^2.12.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=26.0.0"
  },
  "packageManager": "bun@1.4.0"
}